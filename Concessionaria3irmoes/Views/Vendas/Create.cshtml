@model Concessionaria3irmoes.Models.VendaModel

@{
    ViewData["Title"] = "Registrar Venda";
}

<h2>Finalizar Venda</h2>
<h4 class="text-muted">Veículo: @ViewData["VeiculoNome"]</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="VeiculoId" />
            <input type="hidden" asp-for="ValorOriginal" id="valorOriginal" />

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="control-label">Cliente Comprador</label>
                <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DataVenda" class="control-label"></label>
                <input asp-for="DataVenda" class="form-control" />
                <span asp-validation-for="DataVenda" class="text-danger"></span>
            </div>

            <div class="card bg-light p-3 mb-3">
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label fw-bold">Valor do Veículo:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control-plaintext" readonly value="@Model.ValorOriginal.ToString("C2")" />
                    </div>
                </div>

                <div class="form-group row mb-2">
                    <label asp-for="Desconto" class="col-sm-4 col-form-label fw-bold text-danger">Desconto (R$):</label>
                    <div class="col-sm-8">
                        <input asp-for="Desconto" id="inputDesconto" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Desconto" class="text-danger"></span>
                    </div>
                </div>

                <hr>

                <div class="form-group row">
                    <label asp-for="ValorFinal" class="col-sm-4 col-form-label fw-bold text-success fs-5">TOTAL A PAGAR:</label>
                    <div class="col-sm-8">
                        <input type="text" id="displayTotal" class="form-control-plaintext fs-5 fw-bold text-success" readonly value="@Model.ValorFinal.ToString("C2")" />
                        <input type="hidden" asp-for="ValorFinal" id="inputTotal" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Confirmar Venda" class="btn btn-success btn-lg w-100" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Veiculos" asp-action="Index">Cancelar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Script para atualizar o total automaticamente
        const valorOriginal = parseFloat(document.getElementById('valorOriginal').value.replace(',', '.'));
        const inputDesconto = document.getElementById('inputDesconto');
        const displayTotal = document.getElementById('displayTotal');
        const inputTotal = document.getElementById('inputTotal');

        inputDesconto.addEventListener('input', function() {
            let desconto = parseFloat(this.value);
            if (isNaN(desconto)) desconto = 0;

            let total = valorOriginal - desconto;

            if (total < 0) total = 0; // Impede valor negativo visualmente

            // Atualiza o display (Formatado em R$)
            displayTotal.value = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            
            // Atualiza o valor oculto que vai pro C#
            inputTotal.value = total; // Envia formato americano (ponto) pro backend não confundir
        });
    </script>
}