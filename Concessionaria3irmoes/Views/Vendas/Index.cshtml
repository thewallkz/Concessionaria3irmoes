@model IEnumerable<Concessionaria3irmoes.Models.VendaModel>

@{
    ViewData["Title"] = "Histórico de Vendas";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h1 class="display-5 text-success text-uppercase">Histórico de Vendas</h1>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-cash-stack me-2"></i> Registrar Nova Venda
        </a>
    </div>

    <div class="table-responsive shadow-lg rounded-3 overflow-hidden">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="p-3">
                        @Html.DisplayNameFor(model => model.DataVenda)
                    </th>
                    <th class="p-3">
                        @Html.DisplayNameFor(model => model.Cliente)
                    </th>
                    <th class="p-3 d-none d-md-table-cell">
                        Veículo Vendido
                    </th>
                    <th class="p-3 text-end">
                        @Html.DisplayNameFor(model => model.ValorFinal)
                    </th>
                    <th class="p-3 text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr class="align-middle">
                        <td class="p-3">
                            @item.DataVenda.ToShortDateString()
                        </td>
                        <td class="p-3 fw-bold">
                            @Html.DisplayFor(modelItem => item.Cliente!.Nome)
                        </td>
                        <td class="p-3 d-none d-md-table-cell">
                            @Html.DisplayFor(modelItem => item.Veiculo!.Marca) - @Html.DisplayFor(modelItem => item.Veiculo!.Modelo)
                        </td>
                        <td class="p-3 text-end text-success fw-bolder">
                            R$ @item.ValorFinal.ToString("N2")
                        </td>
                        <td class="p-3 text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="Detalhes"><i class="bi bi-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if (!Model.Any())
    {
        <div class="alert alert-success text-center mt-4">
            Nenhuma venda registrada no momento.
        </div>
    }
</div>