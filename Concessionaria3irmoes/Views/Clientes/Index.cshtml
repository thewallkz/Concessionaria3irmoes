@model IEnumerable<Concessionaria3irmoes.Models.ClienteModel>

@{
    ViewData["Title"] = "Gestão de Clientes";
}

<div class="container mt-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h1 class="display-5 text-primary text-uppercase">Carteira de Clientes</h1>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Novo Cliente
        </a>
    </div>

    <div class="table-responsive shadow-lg rounded-3 overflow-hidden">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="p-3">
                        @Html.DisplayNameFor(model => model.Nome)
                    </th>
                    <th class="p-3 d-none d-md-table-cell">
                        @Html.DisplayNameFor(model => model.CPF)
                    </th>
                    <th class="p-3">
                        @Html.DisplayNameFor(model => model.Telefone)
                    </th>
                    <th class="p-3 d-none d-lg-table-cell">
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th class="p-3 text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr class="align-middle">
                        <td class="p-3 fw-bold">
                            @Html.DisplayFor(modelItem => item.Nome)
                        </td>
                        <td class="p-3 d-none d-md-table-cell">
                            @Html.DisplayFor(modelItem => item.CPF)
                        </td>
                        <td class="p-3">
                            @Html.DisplayFor(modelItem => item.Telefone)
                        </td>
                        <td class="p-3 d-none d-lg-table-cell small">
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td class="p-3 text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="Detalhes"><i class="bi bi-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4">
            Nenhum cliente cadastrado no momento.
        </div>
    }

</div>