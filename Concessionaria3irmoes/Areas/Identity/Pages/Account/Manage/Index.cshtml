@page
@model IndexModel
@{
    ViewData["Title"] = "Meu Perfil";
    ViewData["ActivePage"] = "Index";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow border-0 mt-4">
            <div class="card-header bg-dark text-white text-center py-4">
                <h3 class="fw-bold mb-0">@ViewData["Title"]</h3>
                <p class="mb-0 text-white-50">Gerencie suas informações pessoais</p>
            </div>

            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @Model.StatusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                <form id="profile-form" method="post">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small">E-MAIL / USUÁRIO</label>
                        <input asp-for="Username" class="form-control bg-light" disabled />
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Seu telefone" />
                        <label asp-for="Input.PhoneNumber">Número de Telefone</label>
                    </div>

                    <div class="d-grid">
                        <button id="update-profile-button" type="submit" class="btn btn-primary btn-lg">
                            Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}